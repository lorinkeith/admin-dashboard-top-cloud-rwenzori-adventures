# Use the SAME NEW Top Cloud project in both applications. Never copy Uganda credentials.
VITE_SUPABASE_URL=https://YOUR_TOP_CLOUD_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_TOP_CLOUD_KEY
# Server-side review importer (same project/key; never a service-role key)
SUPABASE_URL=https://YOUR_TOP_CLOUD_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_TOP_CLOUD_KEY
VITE_PUBLIC_SITE_URL=https://YOUR_TOP_CLOUD_PUBLIC_SITE
# Optional: defaults to the dashboard same-origin Pages Function
VITE_REVIEW_IMPORT_API_URL=
